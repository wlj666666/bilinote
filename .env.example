# =============================================================================
# BiliNote 环境变量示例
# Docker 部署：cp .env.example .env，按需修改，然后 docker-compose up --build -d
#
# 注意区分两类变量：
#   1) VITE_* 是【构建时】变量，会被烘进前端 JS bundle。改完必须
#      docker-compose build frontend && docker-compose up -d 才会生效，
#      只 docker-compose restart 不行。
#   2) 其他后端变量是【运行时】变量，改完 docker-compose up -d 即可。
#
# 提醒：LLM API key 不要写在这里！请部署完成后，从前端「模型供应商」页面录入，
#       这些 key 会保存到 SQLite 数据库（./backend/bili_note.db）并随容器持久化。
# =============================================================================

# 通用端口配置
BACKEND_PORT=8483 # 后端端口
FRONTEND_PORT=3015
BACKEND_HOST=0.0.0.0 # 默认为 0.0.0.0，表示监听所有 IP 地址 不建议动
APP_PORT=3015 # docker 部署时对外暴露端口（浏览器访问的端口）

# Docker 构建期镜像源（国内拉不到 docker.io 时改这里，nginx/基础镜像都会跟着换）
# BASE_REGISTRY=docker.m.daocloud.io
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# 反向代理信任的客户端 IP 来源。compose 部署默认 *（仅 Docker 内网可达）；
# 直接把后端暴露到公网时请留空，否则外部可伪造 X-Forwarded-For 绕过登录限流。
FORWARDED_ALLOW_IPS=*

# 前端访问后端用（开发环境直连；Docker 部署下走 nginx 代理，此值仅作回退）
VITE_API_BASE_URL=http://127.0.0.1:8483
VITE_SCREENSHOT_BASE_URL=http://127.0.0.1:8483/static/screenshots
VITE_FRONTEND_PORT=3015

# 生产环境配置
ENV=production
STATIC=/static
OUT_DIR=./static/screenshots
NOTE_OUTPUT_DIR=note_results
IMAGE_BASE_URL=/static/screenshots
DATA_DIR=data

# 存储根目录（默认相对 backend/ 工作目录；容器部署由 compose 显式指向持久化卷）
# STATIC_ROOT=static
# UPLOAD_ROOT=uploads
# VECTOR_DB_DIR=vector_db
# TASK_RUNTIME_DIR=data/task_runtime

# 数据库。默认 sqlite:///bili_note.db（相对 backend/ 工作目录）。
# 容器部署示例：sqlite:////app/backend/data/bili_note.db
# DATABASE_URL=sqlite:///bili_note.db

# FFMPEG 配置（Docker 镜像已内置 ffmpeg，留空即可；自建/桌面端可填绝对路径）
FFMPEG_BIN_PATH=

# 转写器配置
# TRANSCRIBER_TYPE 可选：fast-whisper / bcut / kuaishou / mlx-whisper(仅 Apple Silicon) / groq
TRANSCRIBER_TYPE=fast-whisper
# WHISPER_MODEL_SIZE 默认 tiny (~75MB)，首次启动快；想要更高识别质量可在前端
# 「音频转写配置」页切到 base/small/medium/large。直接在这里改大尺寸会触发
# 首次启动下载 ~1.5GB 文件，慢网络或 4GB 内存的容器容易 OOM。
WHISPER_MODEL_SIZE=tiny

GROQ_TRANSCRIBER_MODEL=whisper-large-v3-turbo # groq提供的faster-whisper 默认为 whisper-large-v3-turbo

# GPU 部署（docker-compose.gpu.yml）时 faster-whisper 的计算精度
# WHISPER_CUDA_COMPUTE_TYPE=int8_float32

# whisper 本地模型从 HuggingFace 下载。镜像默认 HF_ENDPOINT=https://hf-mirror.com（国内友好）。
# 若下载失败（容器连不上镜像站），可在此覆盖为官方源或其它镜像，例如：
#   HF_ENDPOINT=https://huggingface.co
# 注意：宿主机的 VPN/代理默认不会进入容器。若要让模型下载走代理，请在前端「设置」里
# 配置代理（会自动应用到 HuggingFace 下载），或在下面用标准环境变量指定：
#   HTTP_PROXY=http://host.docker.internal:7890
#   HTTPS_PROXY=http://host.docker.internal:7890
# HF_ENDPOINT=https://hf-mirror.com
# 模型接口直连列表（逗号分隔域名），也支持标准 NO_PROXY。
# 国内模型服务无需代理时可填写其域名，如 dashscope.aliyuncs.com。
OPENAI_NO_PROXY=
# 模型请求分阶段超时（秒）；仅应用层重试，默认最多 2 次。
OPENAI_CONNECT_TIMEOUT=10
OPENAI_WRITE_TIMEOUT=30
OPENAI_READ_TIMEOUT=180
OPENAI_RETRY_ATTEMPTS=2
OPENAI_RETRY_BACKOFF_SECONDS=1
OPENAI_MAX_REQUEST_BYTES=8388608
# 画面理解在全片均匀采样，最多生成此数量的拼图。
VIDEO_MAX_GRIDS=24

# 多用户任务调度（单机单调度器；所有用户共用这些资源额度）
TASK_MAX_WORKERS=6
TASK_USER_ACTIVE=1
TASK_USER_QUEUE_LIMIT=3
TASK_QUEUE_LIMIT=20
TASK_GPU_SLOTS=1
TASK_CPU_SLOTS=2
TASK_API_SLOTS=2
TASK_TIMEOUT_SECONDS=7200
# 单次本地推理连续无进度的超时秒数，无单次总时长上限。
TASK_INFERENCE_STALL_TIMEOUT_SECONDS=120
TASK_HEARTBEAT_TIMEOUT_SECONDS=90
TASK_RETRY_ATTEMPTS=2
WHISPER_CPU_THREADS=2
WHISPER_KEEP_DURING_OCR=0
OCR_GPU_RESERVE_MIB=3072
VIDEO_FRAME_WORKERS=2
OCR_THREADS=1
# 硬字幕 OCR（文字提取方式=ocr 时使用）
# OCR_DEVICE 可选 cpu / cuda；GPU 部署（docker-compose.gpu.yml）默认 cuda。
# 设为 cuda 但缺少 GPU 依赖时会【直接报错】，不会静默回退 CPU。
OCR_DEVICE=cpu
OCR_FPS=5
# 可选：同一用户跨任务共享媒体/字幕；默认 backend/data/source_cache。
# SOURCE_CACHE_DIR=./data/source_cache
EMBEDDING_CPU_THREADS=2
# AI 问答（RAG）用的 all-MiniLM-L6-v2 ONNX 模型目录。
# 默认自动查找 backend/models/chroma/onnx_models/all-MiniLM-L6-v2（compose 已把
# ./backend/models 挂到 /app/models），命中后完全离线，不再从 AWS S3 下载。
# 若把模型放在别处，可显式指定该目录（其下需有 onnx/ 子目录）。
# 注意：Chroma 内置下载走 S3 且不认 HF_ENDPOINT，国内未预置时首次要等 20 分钟以上。
# EMBEDDING_MODEL_DIR=/app/models/chroma/onnx_models/all-MiniLM-L6-v2
# Compose 禁止请求内下载；首次部署先运行 scripts/prepare_embeddings.py。
# EMBEDDING_ALLOW_DOWNLOAD=0
# 问答通过后台任务 + 短请求轮询，慢模型不会占用一条公网连接。
CHAT_TIMEOUT_SECONDS=180
CHAT_MAX_WORKERS=2
CHAT_QUEUE_LIMIT=20
# 单 GPU 推理服务要求 TASK_GPU_SLOTS=1。完成 OCR/ASR 混合负载验证后
# 才可用 1 显式放行多 GPU 槽位。
# TASK_ALLOW_MULTI_GPU_SLOTS=0
